{
  "name": "barcode-revolution",
  "version": "1.0.0",
  "private": true,
  "description": "High-End Documentary Motion Graphics - The Barcode Story",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render:1": "remotion render src/index.ts Segment01 out/segment_1.mp4 --gl=angle",
    "render:all": "remotion render src/index.ts MasterVideo out/barcode_revolution_full.mp4 --gl=angle"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.260",
    "@remotion/cli": "^4.0.260",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
