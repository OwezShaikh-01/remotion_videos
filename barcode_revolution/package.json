{
  "name": "barcode-revolution",
  "version": "1.0.0",
  "private": true,
  "description": "High-End Documentary Motion Graphics - The Barcode Story",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "studio": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render:seg01": "remotion render src/index.ts Segment01 out/segment-01.mp4 --codec=h264 --crf=18 --image-format=jpeg --jpeg-quality=95",
    "render:seg02": "remotion render src/index.ts Segment02 out/segment-02.mp4 --codec=h264 --crf=18 --image-format=jpeg --jpeg-quality=95",
    "render:seg03": "remotion render src/index.ts Segment03 out/segment-03.mp4 --codec=h264 --crf=18 --image-format=jpeg --jpeg-quality=95",
    "render:1": "remotion render src/index.ts Segment01 out/segment-01.mp4 --codec=h264 --crf=18 --image-format=jpeg --jpeg-quality=95"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.260",
    "@remotion/cli": "^4.0.260",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
