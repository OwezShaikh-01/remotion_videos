{
  "name": "barcode-revolution",
  "version": "1.0.0",
  "description": "High-end documentary motion graphics video about the invention of the barcode (3m 38s, 1080p, 30fps).",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts BarcodeRevolution out/video.mp4",
    "render": "remotion render src/index.ts BarcodeRevolution out/video.mp4 --gl=angle --concurrency=4",
    "render:segment-01": "remotion render src/index.ts Segment01 out/segment_01_invisible_pattern.mp4 --gl=angle --concurrency=4",
    "still": "remotion still src/index.ts BarcodeRevolution out/still.png"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.220"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
